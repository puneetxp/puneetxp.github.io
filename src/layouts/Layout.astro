---
export interface Props {
	title: string;
}

import favicon from "../assets/favicon.svg";
import Footer from "../components/Footer.astro";
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={favicon} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
 />
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--accent: 124, 58, 237;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			#da62c4 30%,
			white 60%
		);
	}
	html {
		font-family: system-ui, -apple-system, sans-serif;
		background: linear-gradient(135deg, #f5f3ff 0%, #f6f6f6 100%);
		color: #1f2937;
	}
	body {
		margin: 0;
		padding: 0;
		line-height: 1.6;
	}
	h1, h2, h3, h4, h5, h6 {
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	h1 {
		font-size: 2.25rem;
	}
	h2 {
		font-size: 1.875rem;
		margin-top: 1.5rem;
		margin-bottom: 1rem;
	}
	h3 {
		font-size: 1.5rem;
		margin-top: 1rem;
		margin-bottom: 0.75rem;
	}
	a {
		color: rgb(var(--accent));
		text-decoration: none;
		transition: color 0.2s ease;
	}
	a:hover {
		color: #c4b5fd;
	}
	p {
		margin: 0.75rem 0;
		line-height: 1.7;
	}
	ul, ol {
		margin: 1rem 0;
		padding-left: 1.5rem;
	}
	li {
		margin: 0.5rem 0;
	}
</style>
