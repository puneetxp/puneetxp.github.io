---
import Card from "./Card.astro";
const stackoverflowresponse = await fetch(
    "https://api.stackexchange.com/2.3/users/7609791?order=desc&sort=reputation&site=stackoverflow"
);
const stackoverflow = await stackoverflowresponse.json();
---

<div class="w-full">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-gray-800 flex items-center justify-center gap-3">
      <i class="fas fa-network-wired text-purple-600"></i>
      Connect With Me
    </h2>
    <p class="text-gray-600 mt-2">Follow my work and connect on social platforms</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 max-w-4xl mx-auto">
    <!-- Twitter -->
    <a href="https://twitter.com/Puneetsharmakau" target="_blank" class="group">
      <div class="bg-white rounded-lg shadow-md p-6 text-center hover:shadow-lg transition transform hover:scale-105">
        <i class="fab fa-twitter text-3xl text-blue-400 mb-2"></i>
        <p class="text-sm font-semibold text-gray-700">Twitter</p>
      </div>
    </a>

    <!-- CodePen -->
    <a href="https://codepen.io/puneetxp" target="_blank" class="group">
      <div class="bg-white rounded-lg shadow-md p-6 text-center hover:shadow-lg transition transform hover:scale-105">
        <i class="fab fa-codepen text-3xl text-gray-800 mb-2"></i>
        <p class="text-sm font-semibold text-gray-700">CodePen</p>
      </div>
    </a>

    <!-- GitHub -->
    <a href="https://github.com/puneetxp" target="_blank" class="group">
      <div class="bg-white rounded-lg shadow-md p-6 text-center hover:shadow-lg transition transform hover:scale-105">
        <i class="fab fa-github text-3xl text-gray-800 mb-2"></i>
        <p class="text-sm font-semibold text-gray-700">GitHub</p>
      </div>
    </a>

    <!-- Stack Overflow -->
    <a href="https://stackoverflow.com/users/7609791/puneet-sharma" target="_blank" class="group">
      <div class="bg-white rounded-lg shadow-md p-6 text-center hover:shadow-lg transition transform hover:scale-105">
        <i class="fab fa-stack-overflow text-3xl text-orange-500 mb-2"></i>
        <p class="text-sm font-semibold text-gray-700">Stack Overflow</p>
        {stackoverflow.items && (
          <p class="text-xs text-purple-600 font-bold mt-1">Rep: {stackoverflow.items[0].reputation}</p>
        )}
      </div>
    </a>

    <!-- Email -->
    <a href="mailto:punee@intaxing.in" class="group">
      <div class="bg-white rounded-lg shadow-md p-6 text-center hover:shadow-lg transition transform hover:scale-105">
        <i class="fas fa-envelope text-3xl text-red-500 mb-2"></i>
        <p class="text-sm font-semibold text-gray-700">Email</p>
      </div>
    </a>
  </div>
</div>

<style>
  div {
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
