---
import js from "../assets/svg/js.svg";
import html5 from "../assets/svg/html5.svg";
import css from "../assets/svg/css.svg";
import php from "../assets/svg/php1.svg";
import mysql from "../assets/svg/mysql.svg";
import dart from "../assets/svg/dart.svg";
import sass from "../assets/svg/sass.svg";
import apache from "../assets/svg/apache.svg";
import vuejs from "../assets/svg/vuejs.svg";
import deno from "../assets/svg/deno.svg";
import python from "../assets/svg/python.svg";
import csharp from "../assets/svg/csharp.svg";
import alpine from "../assets/svg/alpinejs.svg";
import nginx from "../assets/svg/nginx.svg";
import tailwind from "../assets/svg/tailwind.svg";
import bootstrap from "../assets/svg/bootstrap.svg";
import kotlin from "../assets/svg/kotlin.svg";
import android from "../assets/svg/android.svg";
const setof = {
  language: [
    { name: "python", src: python },
    { name: "php", src: php },
    { name: "javascript", src: js },
    { name: "html", src: html5 },
    { name: "css", src: css },
    { name: "c#", src: csharp },
    { name: "mysql", src: mysql },
    { name: "sass", src: sass },
    { name: "dart", src: dart },
    { name: "kotlin", src: kotlin }
  ],
  frameworks: [
    { name: "laravel", src: "https://laravel.com/img/logomark.min.svg" },
    { name: "vuejs", src: vuejs },
    {
      name: "angular",
      src: "https://angular.io/assets/images/logos/angular/angular.svg",
    },
    {
      name: "solidjs",
      src: "https://www.solidjs.com/assets/logo-123b04bc.svg",
    },
    { name: "deno", src: deno },
    { name: "alpinejs", src: alpine },
    {
      name: "astro",
      src: "https://astro.build/assets/press/astro-icon-dark.svg",
    },
    { name: "tailwind", src: tailwind },
    { name: "bootstrap", src: bootstrap },
    { name: "nginx", src: nginx },
    {
      name: "langchain",
      src: "https://cdn.jsdelivr.net/gh/langchain-ai/langchain@master/docs/static/svg/logo.svg",
    },
    {
      name: "langgraph",
      src: "https://raw.githubusercontent.com/langchain-ai/langgraph/main/docs/static/img/logo.svg",
    },
    {
      name: "n8n",
      src: "https://cdn.jsdelivr.net/gh/n8n-io/n8n@master/packages/cli/commands/openapi/github-assets/n8n-logo.svg",
    },
  ],
};
---

<div class="w-full">
  <!-- Languages Section -->
  <div class="mb-12">
    <h3 class="text-2xl font-bold text-gray-800 mb-6 text-center">
      <i class="fas fa-code mr-2 text-purple-600"></i>Languages
    </h3>
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-6 justify-items-center bg-white rounded-lg shadow-md p-8">
      {setof.language.map((lang) => (
        <div class="flex flex-col items-center group cursor-pointer">
          <div class="relative">
            <img src={lang.src} alt={lang.name} class="w-16 h-16 transition transform group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-r from-purple-600 to-indigo-600 rounded-full opacity-0 group-hover:opacity-10 transition"></div>
          </div>
          <p class="text-sm font-semibold text-gray-700 mt-2 capitalize text-center">{lang.name}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Frameworks Section -->
  <div>
    <h3 class="text-2xl font-bold text-gray-800 mb-6 text-center">
      <i class="fas fa-cube mr-2 text-indigo-600"></i>Frameworks & Tools
    </h3>
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-6 justify-items-center bg-white rounded-lg shadow-md p-8">
      {setof.frameworks.map((framework) => (
        <div class="flex flex-col items-center group cursor-pointer">
          <div class="relative">
            <img src={framework.src} alt={framework.name} class="w-16 h-16 transition transform group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-r from-purple-600 to-indigo-600 rounded-full opacity-0 group-hover:opacity-10 transition"></div>
          </div>
          <p class="text-sm font-semibold text-gray-700 mt-2 capitalize text-center">{framework.name}</p>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  div {
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
