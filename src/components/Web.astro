---
export interface Props {
  path: string;
}
import { website } from "../../scripts/website.js";
import { getFilenameAndExtension } from "../Js/myfunc.js";
import Card from "./Card.astro";
import Detail from "./Detail.astro";
const { path } = Astro.props;
let imagesprod = [];
let imagesdev = [];
let imagespartial = [];

try {
  const liveprod = await Astro.glob("/screenshots/live/*");
  imagesprod = liveprod.map((file) => file.default);
} catch (e) {
  // No live screenshots found
}

try {
  const devshots = await Astro.glob("/screenshots/dev/*");
  imagesdev = devshots.map((file) => file.default);
} catch (e) {
  // No dev screenshots found
}

try {
  const partialshots = await Astro.glob("/screenshots/partial/*");
  imagespartial = partialshots.map((file) => file.default);
} catch (e) {
  // No partial screenshots found
}
---

<div class="my-4 rounded-[2rem] border border-violet-200 bg-white/80 p-4 shadow-[0_20px_60px_rgba(79,70,229,0.08)] backdrop-blur-sm sm:p-6 lg:p-8">
  <div class="mb-4 text-center">
    <span class="inline-flex items-center rounded-full border border-violet-200 bg-violet-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-violet-700">
      WEB PROJECT
    </span>
  </div>
  <div class="mb-8 text-center text-4xl font-black tracking-tight text-slate-900 sm:text-5xl">
    <span class="bg-gradient-to-r from-violet-700 via-indigo-700 to-pink-600 bg-clip-text text-transparent">
      100% Me
    </span>
  </div>

  {
    [
      { title: "PRODUCTION", type: imagesprod, website: website.live, accent: "emerald" },
      { title: "WORK IN PROGRESS", type: imagesdev, website: website.dev, accent: "amber" },
      {
        title: "PARTIAL WORK NOT 100% ME",
        type: imagespartial,
        website: website.partial,
        accent: "rose",
      },
    ].map((type) => (
      <div class="mb-8 last:mb-0">
        <div class="mb-5 flex items-center justify-center gap-3">
          <span class={`h-2.5 w-2.5 rounded-full ${type.accent === 'emerald' ? 'bg-emerald-500' : type.accent === 'amber' ? 'bg-amber-500' : 'bg-rose-400'}`} />
          <div class="text-xl font-bold uppercase tracking-[0.12em] text-slate-700 sm:text-2xl">{type.title}</div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
          {type.type.map((image) => (
            <article class="group overflow-hidden rounded-2xl border border-violet-100 bg-white shadow-[0_12px_30px_rgba(15,23,42,0.05)] transition-all duration-300 hover:-translate-y-1 hover:border-violet-200 hover:shadow-[0_25px_45px_rgba(109,40,217,0.12)]">
              <Card
                target="_black"
                href={
                  "//" +
                    type.website.find((i) =>
                      getFilenameAndExtension(image.src).startsWith(i.website)
                    )?.website || ""
                }>
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
                  <img src={image.src} class="h-56 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                </div>
                <div class="mt-4 flex items-center justify-between gap-3">
                  <div class="text-lg font-bold uppercase tracking-wide text-slate-800">
                    {type.website.find((i) =>
                      getFilenameAndExtension(image.src).startsWith(i.website)
                    )?.label || ""}
                  </div>
                  <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-violet-100 text-sm text-violet-700 transition group-hover:bg-violet-600 group-hover:text-white">
                    →
                  </span>
                </div>
              </Card>
            </article>
          ))}
        </div>
      </div>
    ))
  }
</div>

<!-- Archived/Inactive Projects Section -->
<div class="my-4 rounded-[2rem] border border-slate-200 bg-white/60 p-4 shadow-[0_20px_60px_rgba(15,23,42,0.04)] backdrop-blur-sm opacity-75 transition-all sm:p-6 lg:p-8">
  <div class="mb-6 text-center">
    <span class="inline-flex items-center rounded-full border border-slate-300 bg-slate-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-slate-600">
      ARCHIVED PROJECTS
    </span>
  </div>
  
  <div class="text-center text-sm text-slate-600 mb-6">
    ⚠️ These projects are no longer active/available
  </div>
  
  <details class="cursor-pointer">
    <summary class="text-lg font-bold text-slate-800 hover:text-violet-600 transition duration-200 p-4 rounded-xl bg-slate-50 hover:bg-slate-100">
      📦 View Inactive Projects
    </summary>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white p-4 shadow-[0_12px_30px_rgba(15,23,42,0.05)] transition-all duration-300 hover:border-violet-200 hover:shadow-[0_25px_45px_rgba(109,40,217,0.12)]">
        <div class="font-bold text-slate-800">Zyvika</div>
        <div class="text-sm text-slate-600">zyvika.com</div>
      </div>
      <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white p-4 shadow-[0_12px_30px_rgba(15,23,42,0.05)] transition-all duration-300 hover:border-violet-200 hover:shadow-[0_25px_45px_rgba(109,40,217,0.12)]">
        <div class="font-bold text-slate-800">Zyvika App</div>
        <div class="text-sm text-slate-600">app.zyvika.com</div>
      </div>
      <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white p-4 shadow-[0_12px_30px_rgba(15,23,42,0.05)] transition-all duration-300 hover:border-violet-200 hover:shadow-[0_25px_45px_rgba(109,40,217,0.12)]">
        <div class="font-bold text-slate-800">MFD Rent</div>
        <div class="text-sm text-slate-600">mfdrent.in</div>
      </div>
      <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white p-4 shadow-[0_12px_30px_rgba(15,23,42,0.05)] transition-all duration-300 hover:border-violet-200 hover:shadow-[0_25px_45px_rgba(109,40,217,0.12)]">
        <div class="font-bold text-slate-800">NewCaseMart</div>
        <div class="text-sm text-slate-600">newcasemart.com</div>
      </div>
      <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white p-4 shadow-[0_12px_30px_rgba(15,23,42,0.05)] transition-all duration-300 hover:border-violet-200 hover:shadow-[0_25px_45px_rgba(109,40,217,0.12)]">
        <div class="font-bold text-slate-800">Shop In Factory</div>
        <div class="text-sm text-slate-600">shopinfactory.com</div>
      </div>
    </div>
  </details>
</div>
<style lang="scss">
  a.link-card:is(:hover, :focus-within) {
    background-position: 0;
  }
  a.link-card:is(:hover, :focus-within) h2 {
    color: rgb(var(--accent));
  }
  summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary ~ * {
    animation: ease-opacity-t-b 0.5s ease;
  }

  details {
    user-select: none;
    & summary svg {
      transform: rotate(90deg);
    }
  }
  details[open] {
    & summary svg {
      transform: rotate(-90deg);
    }
  }

  details[open] summary ~ * {
    animation: ease-opacity-t-b 0.5s ease;
  }

  summary {
    cursor: pointer;
  }
  svg {
    transition: all 0.3s;
  }

  /* TO JE TO - TO JE TAJ */

  summary {
    list-style: none; // Remove arrow
    &::-webkit-details-marker {
      display: none; // Remove arrow
    }
    &:hover {
      background-color: #f2f5f9;
    }
    &:focus {
      outline: none;
    }
  }
</style>
