---
export interface Props {
	href: string;
	target ?:string
}

const { href , target = ""} = Astro.props;
---

<li class="link-card">
	<a href={href} target={target} class="grid">
		<slot/>
	</a>
</li>
<style>
	.link-card {
		list-style: none;
		display: flex;
		padding: 0.25rem;
		background: linear-gradient(135deg, #7c3aed 0%, #da62c4 50%, rgba(255,255,255,0.1) 100%);
		background-size: 400%;
		border-radius: 0.75rem;
		background-position: 100%;
		transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
	}

	.link-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15);
	}

	.link-card > a {
		width: 100%;
		text-decoration: none;
		line-height: 1.6;
		padding: 1.5rem;
		border-radius: 0.5rem;
		color: #1f2937;
		background: linear-gradient(135deg, #ffffff 0%, #f3f4f6 100%);
		opacity: 0.95;
		transition: all 0.3s ease;
	}

	.link-card:hover > a {
		opacity: 1;
		background: linear-gradient(135deg, #f8f7ff 0%, #ffffff 100%);
	}

	h2 {
		margin: 0;
		font-size: 1.5rem;
		transition: color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		font-weight: 700;
	}

	p {
		margin-top: 0.5rem;
		margin-bottom: 0;
		color: #4b5563;
		font-weight: 500;
	}

	.link-card:hover h2 {
		color: #7c3aed;
	}

	.link-card:is(:focus-within) {
		background-position: 0;
	}

	.link-card:is(:focus-within) h2 {
		color: #7c3aed;
	}
</style>
